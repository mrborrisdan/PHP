<?php
// Simulated database of users
$users = [
    'john' => 'password123',
    'jane' => 'securepass',
    'admin' => 'admin'
];

// Function to authenticate a user
function authenticate($username, $password, $users) {
    if (isset($users[$username]) && $users[$username] === $password) {
        return true;
    }
    return false;
}


/** next **/
